generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CALL_CENTER
  SUBSCRIBER
  PARTNER
  INSURER
  TEAM_LEAD
}

enum OfferLevel {
  NIVEAU_1
  NIVEAU_2
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum PartnerType {
  MECHANIC
  TOWING
  BOTH
}

enum PartnerStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum IncidentDomain {
  ASSISTANCE
  SECOURS
  MEDICAL
}

enum IncidentType {
  BREAKDOWN
  ACCIDENT
  FLAT_TIRE
  BATTERY
  FUEL
  LOCKOUT
  TOWING
  REMOTE_DIAGNOSIS
  ON_SITE_REPAIR
  EVACUATION
  REPLACEMENT_VEHICLE
  RESCUE
  MEDICAL
  OTHER
}

enum IncidentStatus {
  RECEIVED
  DISPATCHING
  ASSIGNED
  EN_ROUTE
  ON_SITE
  RESOLVED
  CANCELLED
  REDIRECTED
}

enum Priority {
  NORMAL
  HIGH
  CRITICAL
}

enum MedicalPrefinanceStatus {
  REQUESTED
  APPROVED
  DISBURSED
  REIMBURSED
  REJECTED
}

enum MedicalMeasure {
  HEALTH_REFERRAL
  ACTIVATE_HEALTH_FOCAL
  FORWARD_FOLLOWUP_UNIT
  HOSPITAL_CARE_PLAN
  TRANSFER_FINANCE
  ACTIVATE_INSURER_FOCAL
  PNMA_FINANCIAL_ENGAGEMENT
  INSURER_FOLLOWUP
  RECOVERY_ACTIVATION
}

enum RescueCategory {
  ALERT_SERVICES
  ONSITE_EMERGENCY
}

enum RescueAction {
  FIREFIGHTERS
  GENDARMERIE_POLICE
  OTHER_HOMOLOGATED
  ZONE_SECURE
  ALERT_PNMA
  FIRST_AID
  PERSON_SECURE_EVAC
}

enum CallSessionStatus {
  OPEN
  CLOSED
}

enum InsuranceContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum TrainingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  DISPATCH
  APPROVE
  REJECT
  ASSIGN
  CALL_EXCEED
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password       String
  firstName      String
  lastName       String
  phone          String?
  role           UserRole  @default(SUBSCRIBER)
  active         Boolean   @default(true)
  latitude       Float?
  longitude      Float?
  lastLocationAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subscriberProfile SubscriberProfile?
  partnerProfile    PartnerProfile?
  incidentsReported Incident[]           @relation("Reporter")
  interventions     InterventionUpdate[]
  medicalRequests   MedicalPrefinance[]  @relation("MedicalRequester")
  medicalApprovals  MedicalPrefinance[]  @relation("MedicalApprover")
  trainings         TrainingEnrollment[]
  auditLogs         AuditLog[]
  callSessions      CallSession[]        @relation("CallAgent")
  callReviews       CallSession[]        @relation("CallReviewer")
}

model OfferPlan {
  id                       String     @id @default(uuid())
  level                    OfferLevel @unique
  name                     String
  annualPriceFcfa          Int
  medicalCeilingFcfa       Int
  priorityIntervention     Boolean    @default(false)
  premiumAssistance        Boolean    @default(false)
  adminSupport             Boolean    @default(false)
  replacementVehicleIncluded Boolean  @default(false)
  description              String?
  active                   Boolean    @default(true)
  subscriptions            Subscription[]
}

model SubscriberProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName      String?
  isEnterprise     Boolean  @default(false)
  address          String?
  city             String   @default("Dakar")
  region           String   @default("Dakar")
  vehiclePlate     String?
  vehicleBrand     String?
  vehicleModel     String?
  vehicleYear      Int?
  emergencyContact String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  subscriptions    Subscription[]
  insuranceContracts InsuranceContract[]
}

model Subscription {
  id           String             @id @default(uuid())
  subscriberId String
  subscriber   SubscriberProfile  @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  offerPlanId  String
  offerPlan    OfferPlan          @relation(fields: [offerPlanId], references: [id])
  status       SubscriptionStatus @default(ACTIVE)
  startedAt    DateTime           @default(now())
  expiresAt    DateTime
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model PartnerProfile {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  type         PartnerType   @default(MECHANIC)
  status       PartnerStatus @default(AVAILABLE)
  city         String        @default("Dakar")
  address      String?
  latitude     Float
  longitude    Float
  coverageKm   Float         @default(30)
  rating       Float         @default(4.5)
  phone        String?
  specialties  String[]
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  incidents    Incident[]    @relation("AssignedPartner")
}

model Incident {
  id                String         @id @default(uuid())
  reference         String         @unique
  domain            IncidentDomain @default(ASSISTANCE)
  type              IncidentType
  status            IncidentStatus @default(RECEIVED)
  priority          Priority       @default(NORMAL)
  description       String?
  latitude          Float
  longitude         Float
  address           String?
  city              String?
  region            String?
  reporterId        String
  reporter          User           @relation("Reporter", fields: [reporterId], references: [id])
  assignedPartnerId String?
  assignedPartner   PartnerProfile? @relation("AssignedPartner", fields: [assignedPartnerId], references: [id])
  estimatedEtaMin   Int?
  distanceKm        Float?
  replacementEligible Boolean      @default(false)
  redirectedService String?
  resolvedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  updates           InterventionUpdate[]
  medicalPrefinance MedicalPrefinance?
  aiSuggestions     AiSuggestion[]
  callSessions      CallSession[]
  rescueActions     IncidentRescueAction[]
  medicalMeasures   IncidentMedicalMeasure[]
}

model InterventionUpdate {
  id         String         @id @default(uuid())
  incidentId String
  incident   Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?          @relation(fields: [authorId], references: [id])
  status     IncidentStatus
  message    String
  latitude   Float?
  longitude  Float?
  createdAt  DateTime       @default(now())
}

model IncidentRescueAction {
  id         String         @id @default(uuid())
  incidentId String
  incident   Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  category   RescueCategory
  action     RescueAction
  notes      String?
  completed  Boolean        @default(false)
  createdAt  DateTime       @default(now())
}

model IncidentMedicalMeasure {
  id         String         @id @default(uuid())
  incidentId String
  incident   Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  measure    MedicalMeasure
  notes      String?
  completed  Boolean        @default(false)
  createdAt  DateTime       @default(now())
}

model CallSession {
  id              String            @id @default(uuid())
  reference       String            @unique
  agentId         String
  agent           User              @relation("CallAgent", fields: [agentId], references: [id])
  incidentId      String?
  incident        Incident?         @relation(fields: [incidentId], references: [id])
  packetMinutes   Int               @default(5)
  packetsUsed     Int               @default(1)
  startedAt       DateTime          @default(now())
  endedAt         DateTime?
  elapsedSec      Int               @default(0)
  countdownRemain Int               @default(300)
  exceeded        Boolean           @default(false)
  status          CallSessionStatus @default(OPEN)
  decision        String?
  notes           String?
  reviewedById    String?
  reviewedBy      User?             @relation("CallReviewer", fields: [reviewedById], references: [id])
  reviewNotes     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model MedicalBudgetConfig {
  id            String  @id @default(uuid())
  year          Int
  month         Int?
  region        String?
  objectiveFcfa Int
  label         String?
  active        Boolean @default(true)

  @@unique([year, month, region])
}

model InsurancePartner {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  phone     String?
  email     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  contracts InsuranceContract[]
}

model InsuranceContract {
  id                String                  @id @default(uuid())
  reference         String                  @unique
  subscriberId      String
  subscriber        SubscriberProfile       @relation(fields: [subscriberId], references: [id])
  insurerId         String
  insurer           InsurancePartner        @relation(fields: [insurerId], references: [id])
  vehiclePlate      String
  coverageType      String
  annualPremiumFcfa Int
  status            InsuranceContractStatus @default(DRAFT)
  startedAt         DateTime?
  expiresAt         DateTime?
  negotiatedByPnma  Boolean                 @default(true)
  notes             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
}

model MedicalPrefinance {
  id           String                  @id @default(uuid())
  reference    String                  @unique
  incidentId   String?                 @unique
  incident     Incident?               @relation(fields: [incidentId], references: [id])
  requesterId  String
  requester    User                    @relation("MedicalRequester", fields: [requesterId], references: [id])
  approverId   String?
  approver     User?                   @relation("MedicalApprover", fields: [approverId], references: [id])
  amountFcfa   Int
  ceilingFcfa  Int
  hospitalName String?
  diagnosis    String?
  region       String?
  status       MedicalPrefinanceStatus @default(REQUESTED)
  notes        String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
}

model TrainingSession {
  id          String         @id @default(uuid())
  title       String
  description String?
  city        String
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int            @default(20)
  status      TrainingStatus @default(SCHEDULED)
  createdAt   DateTime       @default(now())
  enrollments TrainingEnrollment[]
}

model TrainingEnrollment {
  id        String          @id @default(uuid())
  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  attended  Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@unique([sessionId, userId])
}

model AiSuggestion {
  id         String    @id @default(uuid())
  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  kind       String
  payload    Json
  score      Float?
  applied    Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  action    AuditAction
  entity    String
  entityId  String?
  meta      Json?
  ipAddress String?
  createdAt DateTime    @default(now())
}
